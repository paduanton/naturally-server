<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory="/tmp/naturally-phpunit"
         recordTestRunHistory="false"
         colors="false"
         failOnAllIssues="true"
         failOnEmptyTestSuite="true"
         requireCoverageMetadata="true"
         beStrictAboutCoverageMetadata="true"
         beStrictAboutOutputDuringTests="true"
         displayDetailsOnAllIssues="true">
    <testsuites>
        <testsuite name="RuntimeServices">
            <file>tests/Integration/RuntimeServicesTest.php</file>
            <file>tests/Integration/IdentitySchemaTest.php</file>
            <file>tests/Integration/DatabaseFixtureTest.php</file>
            <file>tests/Integration/DatabaseScopeTest.php</file>
            <file>tests/Integration/RegistrationCaseTest.php</file>
            <file>tests/Integration/BrowserTransportTest.php</file>
            <file>tests/Integration/BrowserOriginTest.php</file>
            <file>tests/Integration/BrowserEmailVerificationTest.php</file>
            <file>tests/Integration/BrowserVerificationResendTest.php</file>
            <file>tests/Integration/BrowserRecoveryRequestTest.php</file>
            <file>tests/Integration/PasswordRecoveryCaseTest.php</file>
            <file>tests/Integration/BrowserRegistrationTest.php</file>
            <file>tests/Integration/BrowserLoginTest.php</file>
            <file>tests/Integration/BrowserSessionTest.php</file>
            <file>tests/Integration/BrowserRevocationTest.php</file>
            <file>tests/Integration/BrowserPasswordTest.php</file>
            <file>tests/Integration/BrowserCredentialRevisionTest.php</file>
            <file>tests/Integration/PasswordMutationTest.php</file>
            <file>tests/Integration/IdentityCredentialsSchemaTest.php</file>
            <file>tests/Integration/IdentityPersistenceTest.php</file>
            <file>tests/Integration/IdentityPhoneSchemaTest.php</file>
            <file>tests/Integration/RecipeSchemaTest.php</file>
            <file>tests/Integration/RecipePersistenceTest.php</file>
            <file>tests/Integration/CommunityRelationsTest.php</file>
            <file>tests/Integration/CommunityFeedbackTest.php</file>
            <file>tests/Integration/MediaAssetTest.php</file>
            <file>tests/Integration/MediaImageTest.php</file>
            <file>tests/Integration/PdfDownloadPersistenceTest.php</file>
            <file>tests/Integration/IdentityContactPersistenceTest.php</file>
            <file>tests/Integration/ModularSchemaLifecycleTest.php</file>
            <file>tests/Integration/SchemaContentionTest.php</file>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">app</directory>
            <directory suffix=".php">config</directory>
            <directory suffix=".php">bootstrap</directory>
            <directory suffix=".php">routes</directory>
            <directory suffix=".php">public</directory>
            <file>artisan</file>
        </include>
    </source>
    <coverage branchCoverage="true" includeUncoveredFiles="true" disableCodeCoverageIgnore="true"/>
</phpunit>
